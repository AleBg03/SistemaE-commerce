<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="ecommercePU">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>it.unina.Entity.Utente_Registrato</class>
        <class>it.unina.Entity.Cliente</class>
        <class>it.unina.Entity.Amministratore</class>
        <class>it.unina.Entity.Indirizzo</class>
        <class>it.unina.Entity.Carrello</class>
        <class>it.unina.Entity.RigaCarrello</class>
        <class>it.unina.Entity.Categoria</class>
        <class>it.unina.Entity.Prodotto</class>
        <class>it.unina.Entity.Ordine</class>
        <class>it.unina.Entity.RigaOrdine</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://127.0.0.1:3306/ecommerce?createDatabaseIfNotExist=true"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
