<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="it.unina.Boundary.FormGestioneProdotto">
  <grid id="27dc6" binding="jpPrincipale" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <preferredSize width="500" height="400"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="23165" class="javax.swing.JLabel" binding="jptitolo">
